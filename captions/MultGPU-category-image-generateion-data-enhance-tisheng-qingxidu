def ensure_prior_images(args, accelerator):
    """Prepare N_reg generic 'person' class images using the FROZEN pretrained SD model.

    Figure 2 prior-image-knowledge is an offline regularization dataset, not image input
    from the target identities. A preexisting directory is accepted; provenance of
    preexisting files must be recorded separately by the experimenter.
    """
    if not args.with_prior_preservation:
        return
    destination = Path(args.class_data_dir)
    destination.mkdir(parents=True, exist_ok=True)
    def existing_files():
        return sorted(p for p in destination.iterdir() if p.is_file() and p.suffix.lower() in {'.png', '.jpg', '.jpeg'})
    files = existing_files()
    if len(files) < args.num_class_images and args.skip_prior_generation:
        raise RuntimeError(f"Only {len(files)}/{args.num_class_images} generic prior images in {destination}; "
                           "remove --skip_prior_generation or provide enough images")
    if len(files) >= args.num_class_images:
        logger.info("Prior class dataset ready: %d generic person images", args.num_class_images)
        return
    if accelerator.is_main_process:
        logger.info("Generating %d missing generic prior images with FROZEN SD model", args.num_class_images - len(files))
        dtype = torch.float16 if accelerator.device.type == 'cuda' else torch.float32
        pipe = StableDiffusionPipeline.from_pretrained(args.pretrained_model_name_or_path, torch_dtype=dtype)
        pipe = pipe.to(accelerator.device)
        pipe.set_progress_bar_config(disable=True)
        from diffusers import DDIMScheduler
        pipe.scheduler = DDIMScheduler.from_config(pipe.scheduler.config)
        try:
            missing = args.num_class_images - len(files)
            existing_names = {p.name for p in files}
            for k in range(missing):
                index = 0
                while f'prior_{index:05d}.png' in existing_names:
                    index += 1
                name = f'prior_{index:05d}.png'
                prompt = CLASS_TEMPLATES[index % len(CLASS_TEMPLATES)]
                generator = torch.Generator(device=accelerator.device).manual_seed(args.seed + index + 100000)
                with torch.inference_mode():
                    pic = pipe(prompt=prompt, height=args.resolution[0], width=args.resolution[1],
                               num_inference_steps=args.prior_inference_steps,
                               guidance_scale=args.prior_guidance_scale, generator=generator).images[0]
                pic.save(destination / name)
                existing_names.add(name)
                if (k + 1) % 20 == 0 or (k + 1) == missing:
                    logger.info('Generated %d/%d new prior images', k + 1, missing)
            with open(destination / 'generated_prior_config.json', 'w', encoding='utf8') as file:
                json.dump({'source': 'frozen_pretrained_stable_diffusion',
                           'pretrained_model': args.pretrained_model_name_or_path,
                           'resolution': list(args.resolution), 'seed': args.seed,
                           'num_class_images': args.num_class_images}, file, indent=2)
        finally:
            del pipe
            gc.collect()
            if accelerator.device.type == 'cuda':
                torch.cuda.empty_cache()
    accelerator.wait_for_everyone()
    if len(existing_files()) < args.num_class_images:
        raise RuntimeError('Prior generation incomplete; refusing to silently disable prior-preservation loss')

def main(args):
    logging_dir = Path(args.output_dir) / "logs"
    logging_dir.mkdir(parents=True, exist_ok=True)

    accelerator = Accelerator(
        gradient_accumulation_steps=args.gradient_accumulation_steps,
        mixed_precision=args.mixed_precision,
    )

    if args.seed is not None:
        set_seed(args.seed)

    os.makedirs(args.output_dir, exist_ok=True)
    if args.seed is None:
        raise ValueError("A fixed seed is required for reproducible identity prompts")
    ensure_prior_images(args, accelerator)
    if args.prior_only:
        logger.info("Prior-image preparation complete (prior_only)")
        return

    # ============ 加载模型 ============
    subject_dirs = get_subject_directories(args.organize_dir)
    logger.info(f"Training {len(subject_dirs)} subjects: {list(subject_dirs.keys())}")

    tokenizer = CLIPTokenizer.from_pretrained(
        args.pretrained_model_name_or_path,
        subfolder="tokenizer",
    )

    text_encoder = CLIPTextModel.from_pretrained(
        args.pretrained_model_name_or_path,
        subfolder="text_encoder",
    )

    vae = AutoencoderKL.from_pretrained(
        args.pretrained_model_name_or_path,
        subfolder="vae",
    )

    unet = UNet2DConditionModel.from_pretrained(
        args.pretrained_model_name_or_path,
        subfolder="unet",
    )

    placeholder_token_ids, placeholder_tokens, index_no_updates = setup_subject_tokens(
        subject_dirs,
        tokenizer,
        text_encoder,
        args.initializer_token,
    )

    if args.use_xformers:
        try:
            unet.enable_xformers_memory_efficient_attention()
            vae.enable_xformers_memory_efficient_attention()
        except Exception as e:
            logger.warning(f"xformers not available: {e}")

    if args.gradient_checkpointing:
        unet.enable_gradient_checkpointing()

    unet.requires_grad_(False)
    vae.requires_grad_(False)

    # ============ 注入 LoRA ============
    lora_attn_procs = {}
    for name in unet.attn_processors.keys():
        cross_attention_dim = None if name.endswith("attn1.processor") else unet.config.cross_attention_dim
        if name.startswith("mid_block"):
            hidden_size = unet.config.block_out_channels[-1]
        elif name.startswith("up_blocks"):
            block_id = int(name[len("up_blocks.")])
            hidden_size = list(reversed(unet.config.block_out_channels))[block_id]
        elif name.startswith("down_blocks"):
            block_id = int(name[len("down_blocks.")])
            hidden_size = unet.config.block_out_channels[block_id]

        # §3.2 explicitly places LoRA in cross-attention (attn2). Keep self-attention frozen.
        if name.endswith("attn1.processor"):
            lora_attn_procs[name] = unet.attn_processors[name]
        else:
            lora_attn_procs[name] = LoRAAttnProcessor(
                hidden_size=hidden_size,
                cross_attention_dim=cross_attention_dim,
                rank=args.lora_rank,
            )

    unet.set_attn_processor(lora_attn_procs)
    lora_layers = AttnProcsLayers({name: proc for name, proc in unet.attn_processors.items()
                                   if isinstance(proc, (LoRAAttnProcessor, LoRAAttnProcessor2_0))})

    params_to_freeze = itertools.chain(
        text_encoder.text_model.encoder.parameters(),
        text_encoder.text_model.final_layer_norm.parameters(),
        text_encoder.text_model.embeddings.position_embedding.parameters(),
    )
    for param in params_to_freeze:
        param.requires_grad = False

    # ============ 创建实例数据集 (你的目标行人) ============
    train_dataset = MultiSubjectDataset(
        subject_dirs=subject_dirs,
        placeholder_tokens=placeholder_tokens,
        tokenizer=tokenizer,
        size=args.resolution,
        center_crop=args.center_crop,
        color_jitter=args.color_jitter,
    )

    # ============ 创建类别先验数据集 (通用行人) ============
    class_dataset = None
    if args.with_prior_preservation:
        class_dataset = ClassPriorDataset(
            class_data_root=args.class_data_dir,
            tokenizer=tokenizer,
            size=args.resolution,
            num_class_images=args.num_class_images,
        )

        if len(class_dataset) == 0:
            raise RuntimeError("Prior-preservation dataset is empty; prepare --class_data_dir first")

    # ============ 定义 collate 函数 ============
    def collate_fn(examples):
        input_ids = [example["instance_prompt_ids"] for example in examples]
        pixel_values = [example["instance_images"] for example in examples]

        pixel_values = torch.stack(pixel_values)
        pixel_values = pixel_values.to(memory_format=torch.contiguous_format).float()

        input_ids = tokenizer.pad(
            {"input_ids": input_ids},
            padding="max_length",
            max_length=tokenizer.model_max_length,
            return_tensors="pt",
        ).input_ids

        batch = {
            "input_ids": input_ids,
            "pixel_values": pixel_values,
        }

        # ============ 新增: 添加类别先验数据 ============
        if args.with_prior_preservation and class_dataset is not None:
            # 从类别数据集中随机采样
            class_indices = torch.randint(0, len(class_dataset), (len(examples),))
            class_examples = [class_dataset[i] for i in class_indices]

            class_input_ids = [example["class_prompt_ids"] for example in class_examples]
            class_pixel_values = [example["class_images"] for example in class_examples]

            class_pixel_values = torch.stack(class_pixel_values)
            class_pixel_values = class_pixel_values.to(memory_format=torch.contiguous_format).float()

            class_input_ids = tokenizer.pad(
                {"input_ids": class_input_ids},
                padding="max_length",
                max_length=tokenizer.model_max_length,
                return_tensors="pt",
            ).input_ids

            batch["class_input_ids"] = class_input_ids
            batch["class_pixel_values"] = class_pixel_values

        return batch

    train_dataloader = torch.utils.data.DataLoader(
        train_dataset,
        batch_size=args.train_batch_size,
        collate_fn=collate_fn,
        shuffle=True,
        num_workers=0,
    )

    # ============ Setup optimizer ============
    params_to_optimize = [
        {"params": lora_layers.parameters(), "lr": args.learning_rate},
        {"params": text_encoder.get_input_embeddings().parameters(), "lr": args.learning_rate_ti},
    ]

    optimizer = torch.optim.AdamW(
        params_to_optimize,
        betas=(0.9, 0.999),
        weight_decay=0.01,
        eps=1e-08,
    )

    # ============ Setup scheduler ============
    num_update_steps_per_epoch = math.ceil(
        len(train_dataloader) / args.gradient_accumulation_steps
    )

    # ✅ 计算实际训练步数
    steps_based_on_epochs = args.num_train_epochs * num_update_steps_per_epoch

    if args.max_train_steps is None:
        actual_max_steps = steps_based_on_epochs
        logger.info(f"max_train_steps not set, using epochs: {actual_max_steps} steps")
    else:
        actual_max_steps = min(args.max_train_steps, steps_based_on_epochs)
        if args.max_train_steps > steps_based_on_epochs:
            logger.warning(
                f"max_train_steps ({args.max_train_steps}) > steps from epochs ({steps_based_on_epochs}). "
                f"Training will stop at {steps_based_on_epochs} steps."
            )

    # ✅ 更新为实际值
    args.max_train_steps = actual_max_steps


    lr_scheduler = get_scheduler(
        "cosine",
        optimizer=optimizer,
        num_warmup_steps=500,
        num_training_steps=args.max_train_steps,
    )

    # ============ Prepare with accelerator ============
    # lora_layers references the LoRA parameters inside UNet; do not wrap it a second time.
    unet, text_encoder, train_dataloader, optimizer, lr_scheduler = accelerator.prepare(
        unet, text_encoder, train_dataloader, optimizer, lr_scheduler
    )

    weight_dtype = torch.float32
    if accelerator.mixed_precision == "fp16":
        weight_dtype = torch.float16
    elif accelerator.mixed_precision == "bf16":
        weight_dtype = torch.bfloat16

    vae.to(accelerator.device, dtype=weight_dtype)
    unet.to(accelerator.device)
    text_encoder.to(accelerator.device)
    vae.requires_grad_(False)
    vae.eval()
    index_no_updates = index_no_updates.to(accelerator.device)
    #text_encoder.text_model.embeddings.token_embedding.weight.data = text_encoder.get_input_embeddings().weight.data.float()

    text_encoder_unwrapped = accelerator.unwrap_model(text_encoder)
    text_encoder_unwrapped.text_model.embeddings.token_embedding.weight.data = (
        text_encoder_unwrapped.get_input_embeddings().weight.data.float()
    )

    noise_scheduler = DDPMScheduler.from_config(
        args.pretrained_model_name_or_path, subfolder="scheduler"
    )

    progress_bar = tqdm(
        range(args.max_train_steps),
        disable=not accelerator.is_local_main_process,
    )
    progress_bar.set_description("Steps")
    global_step = 0

    orig_embeds_params = accelerator.unwrap_model(text_encoder).get_input_embeddings().weight.data.detach().clone()

    unet.train()
    text_encoder.train()

    # ============ 训练循环 (带先验保留) ============
    for epoch in range(args.num_train_epochs):
        logger.info(f"Starting epoch {epoch + 1}/{args.num_train_epochs}")

        for step, batch in enumerate(train_dataloader):
            try:
                # ACCELERATE: accumulation context must cover BOTH encoders and the forward passes.
                with accelerator.accumulate(unet, text_encoder):
                    with torch.no_grad():
                        latents = vae.encode(batch["pixel_values"].to(dtype=weight_dtype)).latent_dist.sample()
                        latents = latents * vae.config.scaling_factor if hasattr(vae.config, "scaling_factor") else latents * 0.18215
                    noise = torch.randn_like(latents)
                    timesteps = torch.randint(0, noise_scheduler.config.num_train_timesteps,
                                              (len(latents),), device=latents.device).long()
                    noisy_latents = noise_scheduler.add_noise(latents, noise, timesteps)
                    hidden = text_encoder(batch["input_ids"])[0]
                    prediction = unet(noisy_latents, timesteps, hidden).sample
                    if noise_scheduler.config.prediction_type == "epsilon":
                        target = noise
                    elif noise_scheduler.config.prediction_type == "v_prediction":
                        target = noise_scheduler.get_velocity(latents, noise, timesteps)
                    else:
                        raise ValueError(f"Unsupported noise target {noise_scheduler.config.prediction_type}")
                    instance_loss = F.mse_loss(prediction.float(), target.float())
                    prior_loss = instance_loss.new_zeros(())
                    if args.with_prior_preservation:
                        with torch.no_grad():
                            class_latents = vae.encode(batch["class_pixel_values"].to(dtype=weight_dtype)).latent_dist.sample()
                            class_latents = class_latents * (getattr(vae.config, "scaling_factor", 0.18215))
                        cn = torch.randn_like(class_latents)
                        ct = torch.randint(0, noise_scheduler.config.num_train_timesteps,
                                           (len(class_latents),), device=class_latents.device).long()
                        class_hidden = text_encoder(batch["class_input_ids"])[0]
                        class_prediction = unet(noise_scheduler.add_noise(class_latents, cn, ct), ct, class_hidden).sample
                        class_target = (cn if noise_scheduler.config.prediction_type == "epsilon"
                                        else noise_scheduler.get_velocity(class_latents, cn, ct))
                        prior_loss = F.mse_loss(class_prediction.float(), class_target.float())
                    loss = instance_loss + args.prior_loss_weight * prior_loss
                    if not torch.isfinite(loss):
                        raise RuntimeError(f"Nonfinite loss at optimizer step {global_step}")
                    accelerator.backward(loss)
                    if accelerator.sync_gradients:
                        accelerator.clip_grad_norm_(list(lora_layers.parameters()) +
                                                    list(text_encoder.get_input_embeddings().parameters()), 1.0)
                    optimizer.step()
                    lr_scheduler.step()
                    optimizer.zero_grad(set_to_none=True)
                    if accelerator.sync_gradients:
                        # Keep all original CLIP token embeddings frozen except each identity placeholder.
                        with torch.no_grad():
                            accelerator.unwrap_model(text_encoder).get_input_embeddings().weight.data[index_no_updates] = (
                                orig_embeds_params[index_no_updates])

                # Global step = optimizer updates, not micro-batches. Also align checkpoint cadence.
                if not accelerator.sync_gradients:
                    continue
                global_step += 1
                progress_bar.update(1)
                if global_step % 100 == 0 and accelerator.device.type == 'cuda':
                    torch.cuda.empty_cache()

                # ============ 更新日志：显示实例损失和先验损失 ============
                logs = {
                    "loss": loss.detach().item(),
                    "instance_loss": instance_loss.detach().item(),
                    "prior_loss": prior_loss.detach().item() if args.with_prior_preservation else 0.0,
                    "lr": lr_scheduler.get_last_lr()[0]
                }
                progress_bar.set_postfix(**logs)

                # ============ 详细日志 ============
                if global_step % 100 == 0:
                    logger.info(
                        f"Step {global_step}/{args.max_train_steps} | "
                        f"Epoch {epoch + 1} | "
                        f"Total Loss: {loss.item():.6f} | "
                        f"Instance Loss: {instance_loss.item():.6f} | "
                        f"Prior Loss: {prior_loss.item():.6f} | "
                        f"LR: {lr_scheduler.get_last_lr()[0]:.6e}"
                    )

                # ============ 保存 checkpoint ============
                if global_step % args.save_steps == 0 and accelerator.is_main_process:
                    save_dir = Path(args.output_dir) / f"checkpoint_{global_step}"
                    save_dir.mkdir(exist_ok=True)

                    # 保存 LoRA 权重
                    unet_lora_state_dict = {}
                    for name, processor in accelerator.unwrap_model(unet).attn_processors.items():
                        if isinstance(processor, (LoRAAttnProcessor, LoRAAttnProcessor2_0)):
                            unet_lora_state_dict[name] = {
                                "to_k_lora.down.weight": processor.to_k_lora.down.weight.detach().cpu(),
                                "to_k_lora.up.weight": processor.to_k_lora.up.weight.detach().cpu(),
                                "to_q_lora.down.weight": processor.to_q_lora.down.weight.detach().cpu(),
                                "to_q_lora.up.weight": processor.to_q_lora.up.weight.detach().cpu(),
                                "to_v_lora.down.weight": processor.to_v_lora.down.weight.detach().cpu(),
                                "to_v_lora.up.weight": processor.to_v_lora.up.weight.detach().cpu(),
                                "to_out_lora.down.weight": processor.to_out_lora.down.weight.detach().cpu(),
                                "to_out_lora.up.weight": processor.to_out_lora.up.weight.detach().cpu(),
                            }
                    torch.save(unet_lora_state_dict, save_dir / "unet_lora.pt")

                    # 保存 token embeddings
                    embeds_dict = {}
                    for subject_id, token_id in placeholder_token_ids.items():
                        embeds_dict[placeholder_tokens[subject_id]] = (
                            accelerator.unwrap_model(text_encoder).get_input_embeddings().weight.data[token_id]
                            .detach()
                            .cpu()
                        )
                    torch.save(embeds_dict, save_dir / "embeddings.pt")

                    # 保存 metadata
                    metadata = {
                        "subject_ids": list(placeholder_tokens.keys()),
                        "placeholder_tokens": placeholder_tokens,
                        "subject_random_ids": train_dataset.subject_random_ids,
                        "global_step": global_step,
                        "prior_loss_weight": args.prior_loss_weight,
                        "with_prior_preservation": args.with_prior_preservation,
                        "num_class_images": args.num_class_images,
                        "pretrained_model_name_or_path": args.pretrained_model_name_or_path,
                        "lora_rank": args.lora_rank,
                        "resolution": list(args.resolution),
                        "per_device_batch_size": args.train_batch_size,
                        "gradient_accumulation_steps": args.gradient_accumulation_steps,
                        "optimizer_steps": global_step,
                    }
                    with open(save_dir / "metadata.json", "w") as f:
                        json.dump(metadata, f, indent=2)

                    logger.info(f"✓ Checkpoint saved to {save_dir}")

                if global_step >= args.max_train_steps:
                    logger.info(f"Reached max_train_steps ({args.max_train_steps}), stopping...")
                    break

            except RuntimeError as e:
                if "out of memory" in str(e):
                    logger.error(f"CUDA OOM at step {global_step}!")
                    logger.error(f"Batch size: {batch['pixel_values'].shape[0]}")
                    logger.error(f"Allocated: {torch.cuda.memory_allocated() / 1024 ** 3:.2f}GB")
                    logger.error(f"Reserved: {torch.cuda.memory_reserved() / 1024 ** 3:.2f}GB")

                    torch.cuda.empty_cache()
                    gc.collect()

                    logger.error("Training stopped due to OOM. Try reducing:")
                    logger.error("  - train_batch_size")
                    logger.error("  - lora_rank")
                    logger.error("  - resolution")
                    raise e
                else:
                    logger.error(f"Runtime error at step {global_step}: {str(e)}")
                    raise e

            except Exception as e:
                logger.error(f"Unexpected error at step {global_step}: {type(e).__name__}")
                logger.error(f"Error message: {str(e)}")
                raise e

        if global_step >= args.max_train_steps:
            break

    # ============ Save final model ============
    if accelerator.is_main_process:
        final_dir = Path(args.output_dir) / "final_model"
        final_dir.mkdir(exist_ok=True)

        # 保存 UNet LoRA
        unet_lora_state_dict = {}
        for name, processor in accelerator.unwrap_model(unet).attn_processors.items():
            if isinstance(processor, (LoRAAttnProcessor, LoRAAttnProcessor2_0)):
                unet_lora_state_dict[name] = {
                    "to_k_lora.down.weight": processor.to_k_lora.down.weight.detach().cpu(),
                    "to_k_lora.up.weight": processor.to_k_lora.up.weight.detach().cpu(),
                    "to_q_lora.down.weight": processor.to_q_lora.down.weight.detach().cpu(),
                    "to_q_lora.up.weight": processor.to_q_lora.up.weight.detach().cpu(),
                    "to_v_lora.down.weight": processor.to_v_lora.down.weight.detach().cpu(),
                    "to_v_lora.up.weight": processor.to_v_lora.up.weight.detach().cpu(),
                    "to_out_lora.down.weight": processor.to_out_lora.down.weight.detach().cpu(),
                    "to_out_lora.up.weight": processor.to_out_lora.up.weight.detach().cpu(),
                }
        torch.save(unet_lora_state_dict, final_dir / "unet_lora.pt")

        # 保存 embeddings
        embeds_dict = {}
        for subject_id, token_id in placeholder_token_ids.items():
            embeds_dict[placeholder_tokens[subject_id]] = (
                accelerator.unwrap_model(text_encoder).get_input_embeddings().weight.data[token_id]
                .detach()
                .cpu()
            )
        torch.save(embeds_dict, final_dir / "embeddings.pt")

        # 保存 metadata
        metadata = {
            "subject_ids": list(placeholder_tokens.keys()),
            "placeholder_tokens": placeholder_tokens,
            "subject_random_ids": train_dataset.subject_random_ids,
            "prior_loss_weight": args.prior_loss_weight,
            "with_prior_preservation": args.with_prior_preservation,
            "num_class_images": args.num_class_images,
            "pretrained_model_name_or_path": args.pretrained_model_name_or_path,
            "lora_rank": args.lora_rank,
            "resolution": list(args.resolution),
            "per_device_batch_size": args.train_batch_size,
            "gradient_accumulation_steps": args.gradient_accumulation_steps,
            "optimizer_steps": global_step,
        }
        with open(final_dir / "metadata.json", "w") as f:
            json.dump(metadata, f, indent=2)

        logger.info(f"Training completed! Final model saved to {final_dir}")

    if accelerator.is_main_process:
        protocol_path = Path(args.output_dir) / 'effective_training_config.json'
        with open(protocol_path, 'w', encoding='utf8') as file:
            json.dump({**vars(args), 'effective_optimizer_steps': global_step}, file, indent=2, default=str)
    accelerator.end_training()


if __name__ == "__main__":
    args = parse_args()
    main(args)
